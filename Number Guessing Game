import random

# Step 1: Generate a random secret number.
secret_number = random.randint(1, 20)
attempts = 0

print("=== Welcome to the Number Guessing Game ===")
print("I have selected a number between 1 and 20.")
print("Can you guess the correct number?")

# Step 2: Allow the player to guess.
while True:
    guess = int(input("\nEnter your guess: "))
    attempts = attempts + 1

    # Step 3: Compare the guess with the secret number.
    if guess < secret_number:
        print("Too low! Try a higher number.")

    elif guess > secret_number:
        print("Too high! Try a lower number.")

    else:
        print("Congratulations! You guessed the correct number.")
        print("The secret number was:", secret_number)
        print("Total attempts:", attempts)
        break

# Step 4: Display the final result.
if attempts <= 3:
    print("Excellent! You are a great guesser!")
elif attempts <= 6:
    print("Good job! You found the number.")
else:
    print("Keep practising to improve your guessing skills!")

print("Thanks for playing!")
