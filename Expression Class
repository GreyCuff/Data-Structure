
# Expression Class Activity

class Expression:

    # Parameterized constructor
    def __init__(self, num1, num2, num3):
        self.num1 = num1
        self.num2 = num2
        self.num3 = num3

    # Method to calculate addition
    def addition(self):
        return self.num1 + self.num2 + self.num3

    # Method to calculate subtraction
    def subtraction(self):
        return self.num1 - self.num2 - self.num3

    # Method to calculate multiplication
    def multiplication(self):
        return self.num1 * self.num2 * self.num3

    # Method to calculate a mathematical expression
    def calculate(self):
        return (self.num1 + self.num2) * self.num3


# Take input from the user
a = int(input("Enter the first number: "))
b = int(input("Enter the second number: "))
c = int(input("Enter the third number: "))

# Create an object
exp = Expression(a, b, c)

# Display the results
print("\n--- Expression Results ---")
print("Addition:", exp.addition())
print("Subtraction:", exp.subtraction())
print("Multiplication:", exp.multiplication())
print("Expression (a + b) * c:", exp.calculate())
